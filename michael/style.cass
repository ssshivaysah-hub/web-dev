.container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-align: center;
    min-height: 100vh;
}

.images {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
}

.images img {
    width: 200px;
    height: 200px;
    object-fit: cover;
}

h2 {
    font-size: 36px;
    font-weight: bold;
    margin: 0;
}

p {
    font-size: 18px;
    text-align: center;
    margin: 0;
    max-width: 600px;
}